@model GeniusOneAi.Api.InvoiceGeneratorPageModel
@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";
}
@{
    ViewData["Title"] = "Invoice";
    ViewData["PageId"] = "Invoice";
}

<div class="container">
    <div class="card mt-5">
    <div class="card-header">
            Invoice: <strong>@Model.InvoiceNumber</strong>
            <span class="pull-right"> Status: <strong>Open</strong></span>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="mb-3">From:</h6>
                    <div>
                        <strong>@Model.FirstName @Model.LastName</strong>
                    </div>
                    <div>@Model.Address1</div>
                    <div>@Model.Address2</div>
                    <div>@Model.City, @Model.State @Model.Zipcode</div>
                    <div>Email: @Model.Email</div>
                    <div>Phone: @Model.PrimaryPhone</div>
                </div>

                <div class="col-sm-6"></div>

            </div>
            <div class="table-responsive-sm">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Activity Type</th>
                        <th class="right">Unit Cost</th>
                        <th class="center">Qty</th>
                        <th class="right">Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.InvoiceData)
                    {
                        <tr>
                             <td style="word-wrap: break-word" class="left strong">@Html.Raw(item.ActivityType)</td>
                            <td class="right">$@item.ActivityUnitCost</td>
                            <td class="center">@item.ActivityQuantity</td>
                            <td class="right">$@item.ActivityTotal</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-lg-4 col-sm-5">

                </div>

                <div class="col-lg-4 col-sm-5 ml-auto">
                    <table class="table table-clear">
                        <tbody>
                        <tr>
                            <td class="left">
                                <strong>Total due to worker:</strong>
                            </td>
                            <td class="right">
                                <strong>$@Model.InvoiceTotal</strong>
                            </td>
                        </tr>
                        </tbody>
                    </table>

                </div>

            </div>

        </div>
        <div class="card-footer">Generated By: GeniusOneAi v2.x</div>
    </div>
</div>

