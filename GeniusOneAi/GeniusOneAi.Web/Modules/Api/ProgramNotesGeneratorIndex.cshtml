    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";
}
@{
    ViewData["Title"] = "Progress Notes";
    ViewData["PageId"] = "Progress Notes";
}

@section Head {
    @functions {
    public static string FormatIntoParagraphs(string input, int sentencesPerParagraph = 5)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        var sentences = System.Text.RegularExpressions.Regex.Split(input, @"(?<=[.!?])\s+");
        var sb = new System.Text.StringBuilder();

        for (int i = 0; i < sentences.Length; i += sentencesPerParagraph)
        {
            sb.Append("<p>");
            sb.Append(string.Join(" ", sentences.Skip(i).Take(sentencesPerParagraph)));
            sb.Append("</p>");
        }

        return sb.ToString();
    }
}
}

