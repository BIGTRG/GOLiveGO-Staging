@using GleamTech.AspNet.Core
@using GleamTech.DocumentUltimate
@using GleamTech.DocumentUltimate.AspNet
@using GleamTech.DocumentUltimate.AspNet.UI
@model GeniusOneAi.Document.DocumentfinalizerPageModel

@{
    ViewData["Title"] = "Document Finalizer";
    ViewData["PageId"] = "Document Finalizer";
}

@{
    var path = Model.fileNamePath;
    var toolBar = true;// Model.toolbarVisible;

    var documentViewer = new DocumentViewer
            {
                Width = 1000,
                Height = 1000,
                Document = path,
                ToolbarVisible = toolBar
            };
}
<head>
        <style type="text/css">
        .dv-control {
    width: 100% !important;
    height: 1500px !important;
}
    </style>
</head>
@section ContentHeader {
    <h3>Document Finalizer</h3>
    }
@this.RenderHead(documentViewer)
<div class="s-Panel">
    <section class="content">
        <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-body text-center">
                            <button type="button" onclick="javascript:history.back(-1);" class="btn btn-danger"><i class="fa fa-arrow-left fa-lg"></i> Return</button>
                            @if (Model.isFinal == 0)
                            {
                                <button type="button" onclick="javascript:docEditor('@Model.fileName');" class="btn btn-primary"><i class="fa fa-pencil fa-lg"></i> Edit</button>
                                <button type="button" onclick="javascript:docFinalizer('@Model.fileId');" class="btn btn-success"><i class="fa fa-check fa-lg"></i> Finalize</button>
                            }
                            @if (Model.isFinal == 1)
                            {
                                <button type="button" onclick="javascript:docUnFinalizer('@Model.fileId','@Model.fileName');" class="btn btn-secondary"><i class="fa fa-repeat fa-lg"></i> UnFinalize</button>
                            }
                        </div>
                        </div>
                    </div>
                </div>
            <div class="row"></div><br />
            @this.RenderBody(documentViewer)
        </div>
    </section>
</div>

