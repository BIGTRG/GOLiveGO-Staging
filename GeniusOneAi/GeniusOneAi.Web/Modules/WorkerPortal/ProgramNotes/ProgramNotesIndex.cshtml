                    "Field08": $("#ctr-field08").val(),
                    "Field09": $("#ctr-field09").val(),
                    "Field10": $("#ctr-field10").val(),
                    "NoteUpdateStatus": "SaveAction"

                },
                "EntityId": @Model.ProgressNoteId
                }, (response) =>
        {

            Q.notifySuccess("Progress note saved successfully!",
                "System Alert",
                {
                    progressBar: true,
                    positionClass: "toast-top-center",
                    showDuration: 1000,
                    hideDuration: 1000,
                    timeOut: 5000,
                    closeButton: true
                });
        }, { async: false });

    };
    function showComments(a)
