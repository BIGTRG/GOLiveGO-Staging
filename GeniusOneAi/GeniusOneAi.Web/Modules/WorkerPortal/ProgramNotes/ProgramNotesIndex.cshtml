@model GeniusOneAi.MiscEntities.Entities.TimesheetNoteDataRow
@{

    ViewData["Title"] = "Progress Notes";
    ViewData["PageId"] = "Progress Notes";
    string dateString = Model.ActivityDate.ToString();
    DateTime date;
    bool success = DateTime.TryParse(dateString, out date);
    DayOfWeek? dayOfWeek = null;
    if (success)
    {
        dayOfWeek = date.DayOfWeek;
    }
}

