    function signSubmit()
    {
        Q.confirm(
            "Legal Notification : You are about to authorize an electronic signature. " +
            "Based on the integrity and validity of electronics specifications, " +
            "you are responsible for keeping your signature information confidential.  Click 'Yes' if you agree and 'No' if you dont. ",
            () =>
            {

                Q.serviceRequest(GeniusOneAi.ProgramNoteManager.ProgramNotesService.baseUrl + "/GetSignageData",
                    {},
                    (response) =>
                    {
                        if (!response.signatureGuid || !response.signatureImage || !response.signatureText || !response.signatureVerified)
                        {
                            Q.alert("It appears that you do not have a valid signature created.  Please save your work and create a verified signature then submit again!");
                            return;
                        }


                        Q.serviceRequest(GeniusOneAi.ProgramNoteManager.ProgramNotesService.baseUrl + "/Update",
                            {
                                "Entity": {
                                    "Field00": $("#ctr-field00").val(),
                                    "Field01": $("#ctr-field01").val(),
                                    "Field02": $("#ctr-field02").val(),
                                    "Field03": $("#ctr-field03").val(),
                                    "Field04": $("#ctr-field04").val(),
                                    "Field05": $("#ctr-field05").val(),
                                    "Field06": $("#ctr-field06").val(),
                                    "Field07": $("#ctr-field07").val(),
                                    "Field08": $("#ctr-field08").val(),
                                    "Field09": $("#ctr-field09").val(),
                                    "Field10": $("#ctr-field10").val(),
                                    "SignatureGuid": response.signatureGuid,
                                    "SignatureImage": response.signatureImage,
                                    "ESignaturePlainText": response.signatureText,
                                    "NoteUpdateStatus": "SignAction"

                                },
                                "EntityId": @Model.ProgressNoteId
                                },
                            (response) =>
                            {

                                Q.notifySuccess("Progress note signed successfully!",
                                    "System Alert",
                                    {
                                        progressBar: true,
                                        positionClass: "toast-top-center",
                                        showDuration: 1000,
                                        hideDuration: 1000,
                                        timeOut: 5000,
                                        closeButton: true
                                    });
                                location.replace("/WorkerPortal/Activities");
                            },
                            { async: false });


                    },
                    { async: false });

            },
            {
                onNo: () =>
                {


                },
                onCancel: () =>
                {

                }
            });
    };
    function saveProgress()
    {

        Q.serviceRequest(GeniusOneAi.ProgramNoteManager.ProgramNotesService.baseUrl + "/Update",
            {
                "Entity": {
                    "Field00": $("#ctr-field00").val(),
                    "Field01": $("#ctr-field01").val(),
                    "Field02": $("#ctr-field02").val(),
                    "Field03": $("#ctr-field03").val(),
                    "Field04": $("#ctr-field04").val(),
                    "Field05": $("#ctr-field05").val(),
                    "Field06": $("#ctr-field06").val(),
