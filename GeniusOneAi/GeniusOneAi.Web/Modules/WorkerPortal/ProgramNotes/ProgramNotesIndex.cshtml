    $(document).ready(function ()
    {
        $('#ctr-field00').on('change', function ()
        {
            var selectedValue = $(this).val();
            $.ajax({
                url: '/Api/GetClientGoals/@GeniusOneAi.Modules.Common.CustomClasses.GeniusOneBase.GlobalApiKey/@Model.ClientId/' + selectedValue + '/@dayOfWeek',
                type: 'GET',
                success: function (data)
                {
                    $.each(data, function (key, value)
                    {
                        if (key == 'Goals'){
                            $('.goals').each(function (index)
                            {
                                $(this).val(value);
                            });
                        }
                        if (key == 'Interventions'){
                            $('.interventions').each(function (index)
                            {
                                $(this).val(value);
                            });
                        }
                    });
                },
                error: function (xhr, status, error)
                {
                    alert(xhr.responseText);
